<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础网络：访问报工服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- V3 离线提示页依赖网络状态监听 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ 下载进度 / VPN 状态 / 推送通知需要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WireGuard 的 GoBackend$VpnService 以前台服务运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 前台服务必须声明具体类型；EasyTier VPN 服务属于 connectedDevice -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 仅 Android 9 及以下写公共下载目录需要；Android 10+ 走 MediaStore -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- V2 启动页：作为桌面入口，短暂展示后进入主界面 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- V3 WireGuard 配置界面 -->
        <activity
            android:name=".VpnSettingsActivity"
            android:exported="false"
            android:label="@string/vpn_title" />

        <!-- V4 网络设置：WireGuard / EasyTier 互斥切换 -->
        <activity
            android:name=".NetworkSettingsActivity"
            android:exported="false"
            android:label="@string/network_title" />

        <!-- V4 EasyTier 配置界面 -->
        <activity
            android:name=".EasyTierConfigActivity"
            android:exported="false"
            android:label="@string/easytier_title" />

        <!-- V4 EasyTier VPN 服务：建立 TUN 交 fd 给 native -->
        <service
            android:name=".EasyTierVpnService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 拍照临时文件通过 FileProvider 暴露给系统相机，路径限定 cache/camera/ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
